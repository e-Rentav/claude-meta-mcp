# --- Meta Graph API ---
# Long-lived user access token from your Meta Developer App.
# Required scopes: ads_read (and optionally business_management).
# Generate one at https://developers.facebook.com → your app → Tools → Get Token.
META_ACCESS_TOKEN=

# Graph API version. Tested with v26.0. Older versions get sunset on a rolling
# schedule, so prefer to keep this current.
META_API_VERSION=v26.0

# --- Authentication ---
# Bearer token clients must send in `Authorization: Bearer <token>` to call /mcp.
# v0.1 single-tenant: any client with this token can read your Meta ad data.
# Generate with: openssl rand -hex 32
AUTH_TOKEN=

# Also accept the secret as the last path segment: POST /mcp/<AUTH_TOKEN>.
# For clients that cannot send an Authorization header. The header keeps
# working. Requires a URL-safe AUTH_TOKEN of 32+ chars. Query strings are never
# accepted. true | false (default false).
ALLOW_PATH_SECRET=false

# --- Tool selection ---
# Comma-separated tool groups to expose. Empty = all tools (upstream default).
# Groups: pages, instagram, ads_read, ads_write, catalogs, assets
# (see src/lib/toolsets.ts). Tools not in a listed group are not registered.
TOOLSETS=

# --- Server ---
# Public URL of this deployment. Currently only used in log lines; v0.2 will
# use it for OAuth callback URLs.
PUBLIC_URL=https://connector.example.com

# Port to listen on. Bind behind a reverse proxy (nginx/Caddy) that terminates TLS.
PORT=3210

# Interface to bind. 127.0.0.1 when the reverse proxy runs on the same host (recommended).
HOST=0.0.0.0

# debug | info | warn | error
LOG_LEVEL=info

# --- Spend guards (optional) ---
# Hard caps in account-currency cents, enforced on every create/update of a
# campaign or ad set budget. Leave empty for no cap. Independent of the
# confirm_budget_increase flag, which is always required to raise a budget.
MAX_DAILY_BUDGET_CENTS=
MAX_LIFETIME_BUDGET_CENTS=

# --- Asset store + upload page (optional, v0.6) ---
# Set UPLOAD_DIR to enable: files uploaded on GET /upload (or attached in ChatGPT)
# are stored here and served at PUBLIC_URL/assets/<random-id>.<ext>.
# The connector serves /upload only over loopback — your reverse proxy MUST
# authenticate it (nginx auth_basic), see docs/DEPLOYMENT.md.
UPLOAD_DIR=
UPLOAD_MAX_MB=100
# en | de
UPLOAD_PAGE_LANG=en

# --- Instagram media from a private S3 bucket (optional, fork e-Rentav) ---
# Set MEDIA_BUCKET to enable list_media and the `s3_key` parameter of the
# Instagram publish tools. Upload files under MEDIA_PREFIX (console or
# `aws s3 cp`); Meta gets a pre-signed GET URL valid for MEDIA_URL_TTL_SECONDS.
# Needs AWS credentials with s3:ListBucket (prefix) and s3:GetObject.
MEDIA_BUCKET=
MEDIA_PREFIX=inbox/
MEDIA_URL_TTL_SECONDS=3600

# Seconds a publish tool waits for Instagram to process a video before it
# returns the container_id (finish with publish_instagram_container). 5–240.
IG_CONTAINER_MAX_WAIT_SECONDS=90

# --- AWS entrypoint only (node dist/aws-entry.js, used by run.sh on Lambda) ---
# Reads META_ACCESS_TOKEN and AUTH_TOKEN from SSM Parameter Store
# (SecureString) under this path instead of the environment.
# SSM_PARAMETER_PATH=/erentav/meta-mcp
